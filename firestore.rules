rules_version = '2';

// Règles de sécurité de Wird.
// À coller dans Firebase > Firestore Database > Règles, puis « Publier ».
// Tout le monde peut lire ; on ne peut écrire que des données au bon format.

service cloud.firestore {
  match /databases/{database}/documents {

    function isId(s)   { return s is string && s.matches('^[a-z0-9-]{1,30}$'); }
    function isDate(s) { return s is string && s.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function isGoal(g) {
      return g is map
        && g.keys().hasOnly(['qty', 'unit', 'freq'])
        && g.qty is number && g.qty > 0 && g.qty <= 1000
        && g.unit is string && g.unit.size() <= 20
        && g.freq in ['daily', 'weekly'];
    }

    // Objectifs de chaque membre (un document par prénom)
    match /members/{id} {
      allow read: if true;
      allow create, update: if isId(id)
        && request.resource.data.keys().hasOnly(['name', 'reading', 'memo', 'since', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 40
        && isGoal(request.resource.data.reading)
        && isGoal(request.resource.data.memo)
        && isDate(request.resource.data.since);
      allow delete: if false;
    }

    // Coches : un document par membre et par semaine (identifiant = lundi_prénom)
    match /checks/{id} {
      allow read: if true;
      allow create, update: if isId(request.resource.data.member)
        && isDate(request.resource.data.week)
        && id == request.resource.data.week + '_' + request.resource.data.member
        && request.resource.data.keys().hasOnly(['member', 'week', 'rFreq', 'mFreq', 'r', 'm', 'rWeek', 'mWeek', 'updatedAt'])
        && request.resource.data.rFreq in ['daily', 'weekly']
        && request.resource.data.mFreq in ['daily', 'weekly'];
      allow delete: if false;
    }

    // Qiyam : un document par vendredi, avec le nombre de présents (sans noms)
    match /qiyam/{date} {
      allow read: if true;
      allow create, update: if isDate(date)
        && request.resource.data.keys().hasOnly(['date', 'held', 'count', 'by', 'at'])
        && request.resource.data.date == date
        && request.resource.data.held is bool
        && request.resource.data.count is int
        && request.resource.data.count >= 0
        && request.resource.data.count <= 200
        && isId(request.resource.data.by);
      allow delete: if false;
    }

    // Sessions Coran à la mosquée
    match /sessions/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['date', 'time', 'place', 'note', 'by', 'createdAt'])
        && isDate(request.resource.data.date)
        && request.resource.data.time is string
        && request.resource.data.time.matches('^[0-9]{2}:[0-9]{2}$')
        && request.resource.data.place is string
        && request.resource.data.place.size() <= 80
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 200
        && isId(request.resource.data.by);
      allow delete: if true;
    }
  }
}
